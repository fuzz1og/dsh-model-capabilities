{
  "name": "dsh-model-capabilities",
  "version": "0.4.0",
  "description": "DSH web plugin: per-model thinking-intensity tiers, provider default reasoning, modalities, gateway compat switches and manual request headers for custom llm-pi-ai providers, plus automatic per-DSH-session x-opencode-session injection (opencode Go session affinity) at the wire layer. 模型能力：思考强度档位 / 默认思考强度 / 支持模态 / 兼容开关 / 请求头；每 DSH 会话自动注入 opencode 会话亲和头。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzz1og/dsh-model-capabilities.git"
  },
  "bugs": {
    "url": "https://github.com/fuzz1og/dsh-model-capabilities/issues"
  },
  "homepage": "https://github.com/fuzz1og/dsh-model-capabilities#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
