{
  "name": "dsh-model-capabilities",
  "version": "0.11.0",
  "description": "DSH web plugin: a dedicated 模型能力 settings page (per-provider request headers, gateway compat switches and per-model capabilities, including catalog routes) plus automatic thinking-tier defaults. 模型能力独立设置页 + 思考档位默认注入。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzz1og/dsh-model-capabilities.git"
  },
  "bugs": {
    "url": "https://github.com/fuzz1og/dsh-model-capabilities/issues"
  },
  "homepage": "https://github.com/fuzz1og/dsh-model-capabilities#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:parity": "DSH_REQUIRE_PI_AI_PARITY=1 node --test tests/parity.test.js",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "dsh": "^0.1.7-alpha.1"
  }
}
